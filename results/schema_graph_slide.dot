  PRReviewComments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>PRReviewComments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="comment_id_l"><B>comment_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="comment_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pr_id_l"><I>pr_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pr_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_l"><I>repo_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_l"><I>author_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pull_request_review_id_l"><I>pull_request_review_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pull_request_review_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="in_reply_to_id_l"><I>in_reply_to_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="in_reply_to_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="created_at_l">created_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="created_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
  Pushes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>Pushes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="push_id_l"><B>push_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="push_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="user_id_l"><I>user_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="user_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_l"><I>repo_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="created_at_l">created_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="created_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
  PullRequests:repo_id_r:e -> Repositories:repo_id_l:w [color="#d62728"];
  PullRequests:author_id_r:e -> Users:user_id_l:w [color="#1f77b4"];
  PullRequests:merged_by_id_r:e -> Users:user_id_l:w [color="#1f77b4", style=dashed];
  Issues:repo_id_r:e -> Repositories:repo_id_l:w [color="#d62728"];
  Issues:author_id_r:e -> Users:user_id_l:w [color="#1f77b4"];
