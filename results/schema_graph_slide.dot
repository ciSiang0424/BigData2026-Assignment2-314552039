digraph schema_slide {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.6, size="13.33,7.5", ratio=fill, fontname="Helvetica", label="Schema graph: 8 tables (nodes), 20 foreign keys (edges, FK → referenced PK). PK = primary key, FK = foreign key, time = row-time column; dashed = FK known only later (merged_by_id).\nDataset period used: GH Archive 2025-12-01 00:00 UTC - 2026-11-20 23:59 UTC (= 2025-12-01 08:00 - 2026-11-21 07:59 Taiwan)", labelloc=b, fontsize=15];
  node [shape=plaintext, fontname="Helvetica", fontsize=14];
  edge [penwidth=1.6, arrowsize=0.9];
  { rank=same; PRReviewComments IssueComments Pushes; }
  { rank=same; PRReviews Issues; }
  { rank=same; PullRequests; }
  { rank=same; Users Repositories; }
  Users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="user_id_l"><B>user_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="user_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_l">first_seen_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
  Repositories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>Repositories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="repo_id_l"><B>repo_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="repo_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_l">first_seen_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
  PullRequests [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>PullRequests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="pr_id_l"><B>pr_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="pr_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_l"><I>repo_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_l"><I>author_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="merged_by_id_l"><I>merged_by_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="merged_by_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_l">first_seen_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
  Issues [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79" COLSPAN="2"><FONT COLOR="white"><B>Issues</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="issue_id_l"><B>issue_id</B></TD><TD ALIGN="LEFT" BGCOLOR="#ffe699" PORT="issue_id_r"><FONT POINT-SIZE="9">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_l"><I>repo_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="repo_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_l"><I>author_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="author_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pull_request_id_l"><I>pull_request_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="pull_request_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="assignee_id_l"><I>assignee_id</I></TD><TD ALIGN="LEFT" BGCOLOR="#c6e0b4" PORT="assignee_id_r"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_l">first_seen_at</TD><TD ALIGN="LEFT" BGCOLOR="#ddebf7" PORT="first_seen_at_r"><FONT POINT-SIZE="9">time</FONT></TD></TR></TABLE>>];
